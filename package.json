{
  "name": "telemail",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Apocalypsor <chthon605@gmail.com>",
  "workspaces": [
    "apps/worker",
    "apps/page"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "worker": "bun run --cwd apps/worker",
    "page": "bun run --cwd apps/page",
    "lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "typecheck": "bun run --workspaces typecheck",
    "prepare": "husky",
    "skills:install": "bunx skills experimental_install && mkdir -p .claude/ && ln -sf ../.agents/skills .claude/",
    "skills:update": "bunx skills update"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "wrangler": "^4.118.0"
  },
  "lint-staged": {
    "*": [
      "bun run lint"
    ]
  }
}
